{
    "manifest_version": 3,
    "name": "MSPA Updater",
    "version": "1.1.0",
    "description": "Browser extension for rereading MS Paint Adventures in lockstep with the original updates. The link to the next page only becomes visible if the time you've spent rereading exceeds the original time it took for the update to release.",
    
    "browser_specific_settings": {
        "gecko": {
            "id": "mspa-updater@ashie.blue",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "host_permissions": [
        "*://*.homestuck.com/*",
        "*://homestuck.com/*"
    ],
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
        "matches": [
            "*://*.homestuck.com/*",
            "*://homestuck.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
        "resources": [
            "/files/scheduleshomestuck-default.json",
            "/files/schedulesproblemsleuth-default.json"
        ],
        "matches": ["https://*.homestuck.com/*"]
        }
    ],
    "options_ui": {
        "page": "pages/options/options.html",
        "open_in_tab": true
    },

    "action": {
        "default_icon": {
        "16": "/files/images/extension-icons/mspa16.png",
        "32": "/files/images/extension-icons/mspa32.png"
        },
        "default_popup": "pages/popup/popup.html"
    },
    "icons": {
        "16": "/files/images/extension-icons/mspa16.png",
        "48": "/files/images/extension-icons/mspa48.png",
        "128": "/files/images/extension-icons/mspa128.png"
    }
}